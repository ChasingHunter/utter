{
  "name": "utter",
  "productName": "Utter",
  "version": "0.4.2",
  "description": "Offline push-to-talk dictation for Windows. Hold Right Alt, talk, let go, and the text lands in whatever app you are typing in.",
  "main": "./out/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/stt-bench.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test:e2e": "node build.mjs && node scripts/e2e.mjs",
    "test:hook": "esbuild scripts/hook-test.ts --bundle --platform=node --format=cjs --external:electron --external:koffi --outfile=out/hook-test.js --log-level=warning && node scripts/run-hook-test.mjs",
    "dist": "node scripts/make-icon.mjs && node build.mjs && electron-builder --win --publish never",
    "postinstall": "node scripts/ensure-electron.mjs",
    "model": "node scripts/download-model.mjs",
    "test:keys": "node build.mjs && node scripts/real-key-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@anthropic-ai/sdk": "0.129.0",
    "koffi": "3.3.2",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "dev.utter.desktop",
    "productName": "Utter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**"
    ],
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-win-x64/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": false,
      "artifactName": "Utter-Setup-${version}.${ext}"
    }
  },
  "author": "ChasingHunter"
}
